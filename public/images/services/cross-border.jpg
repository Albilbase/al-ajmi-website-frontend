<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3a8a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="truckGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#dc2626;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ef4444;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#skyGrad)"/>
  
  <!-- Road -->
  <rect x="0" y="400" width="800" height="200" fill="#374151"/>
  <rect x="0" y="490" width="800" height="10" fill="#fbbf24" opacity="0.8"/>
  
  <!-- Truck Body -->
  <rect x="200" y="300" width="400" height="150" fill="url(#truckGrad)" rx="10"/>
  
  <!-- Truck Cabin -->
  <rect x="500" y="250" width="100" height="100" fill="#991b1b" rx="5"/>
  <rect x="510" y="260" width="35" height="40" fill="#60a5fa" opacity="0.6"/>
  <rect x="555" y="260" width="35" height="40" fill="#60a5fa" opacity="0.6"/>
  
  <!-- Cargo Container -->
  <rect x="210" y="310" width="280" height="130" fill="#7c2d12" rx="5"/>
  <line x1="250" y1="310" x2="250" y2="440" stroke="#451a03" stroke-width="3"/>
  <line x1="300" y1="310" x2="300" y2="440" stroke="#451a03" stroke-width="3"/>
  <line x1="350" y1="310" x2="350" y2="440" stroke="#451a03" stroke-width="3"/>
  <line x1="400" y1="310" x2="400" y2="440" stroke="#451a03" stroke-width="3"/>
  <line x1="450" y1="310" x2="450" y2="440" stroke="#451a03" stroke-width="3"/>
  
  <!-- Wheels -->
  <circle cx="280" cy="450" r="35" fill="#1f2937"/>
  <circle cx="280" cy="450" r="20" fill="#4b5563"/>
  <circle cx="520" cy="450" r="35" fill="#1f2937"/>
  <circle cx="520" cy="450" r="20" fill="#4b5563"/>
  <circle cx="560" cy="450" r="35" fill="#1f2937"/>
  <circle cx="560" cy="450" r="20" fill="#4b5563"/>
  
  <!-- Border Crossing Sign -->
  <rect x="650" y="200" width="120" height="150" fill="#065f46" rx="5"/>
  <text x="710" y="250" font-family="Arial" font-size="40" fill="#fff" text-anchor="middle">🚧</text>
  <text x="710" y="290" font-family="Arial" font-size="16" fill="#fff" text-anchor="middle" font-weight="bold">BORDER</text>
  <text x="710" y="310" font-family="Arial" font-size="16" fill="#fff" text-anchor="middle" font-weight="bold">CROSSING</text>
</svg>
